<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.ChangeSim.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.ChangeSim.AppWidgetContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/appwidget_text"
            style="@style/Widget.ChangeSim.AppWidget.InnerView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:gravity="center"
            android:contentDescription="@string/appwidget_text"
            android:text="@string/appwidget_text"
            android:autoSizeMinTextSize="0.01sp"
            android:autoSizeMaxTextSize="100sp"
            android:autoSizeStepGranularity="0.01sp"
            android:textStyle="bold|italic" />


    </LinearLayout>

</RelativeLayout>